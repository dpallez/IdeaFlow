<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.ideaflow</groupId>
  <artifactId>ideaflow-releng</artifactId>
  <version>0.1.0.alpha2</version>
  <packaging>pom</packaging>

  <modules>
    <module>IDEAFlow</module>
    <module>IDEAFlow.tests</module>
    <module>IDEAFlow.feature</module>
    <module>IDEAFlow.update</module>
  </modules>

  <name>IdeaFlow</name>
  <description>Workflow-native evolutionary and metaheuristic optimization for KNIME.</description>
  <url>https://github.com/dpallez/IdeaFlow</url>

  <developers>
    <developer>
      <name>Cazacu Ion</name>
      <email>ion.cazacu@univ-cotedazur.fr</email>
      <roles>
        <role>developer</role>
      </roles>
    </developer>
    <developer>
      <name>Benjamin Foulcher</name>
      <email>benjamin.foulcher@univ-cotedazur.fr</email>
      <roles>
        <role>developer</role>
      </roles>
    </developer>
    <developer>
      <name>Denis Pallez</name>
      <email>denis.pallez@univ-cotedazur.fr</email>
      <organization>I3S</organization>
      <roles>
        <role>owner</role>
      </roles>
    </developer>
  </developers>

  <properties>
    <tycho.version>4.0.13</tycho.version>
    <knime.version>5.11</knime.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <repositories>
    <repository>
      <id>knime-analytics-platform</id>
      <layout>p2</layout>
      <url>https://update.knime.com/analytics-platform/${knime.version}</url>
    </repository>
  </repositories>

  <build>
    <plugins>
      <plugin>
        <groupId>org.eclipse.tycho</groupId>
        <artifactId>tycho-maven-plugin</artifactId>
        <version>${tycho.version}</version>
        <extensions>true</extensions>
      </plugin>
      <plugin>
        <groupId>org.eclipse.tycho</groupId>
        <artifactId>target-platform-configuration</artifactId>
        <version>${tycho.version}</version>
        <configuration>
          <executionEnvironment>JavaSE-21</executionEnvironment>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
